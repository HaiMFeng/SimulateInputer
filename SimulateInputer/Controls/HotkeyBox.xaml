<UserControl x:Class="SimulateInputer.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             IsTabStop="True"
             Cursor="IBeam"
             Height="{StaticResource FieldHeight}"
             FocusVisualStyle="{x:Null}">

    <Grid>
        <Border x:Name="RootBorder" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FieldHoverBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="0"
                           Margin="10,8"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="ValueText"
                           Grid.Column="0"
                           Margin="10,8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="LockText"
                           Grid.Column="1"
                           Margin="8,8,10,8"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="Delete 清除"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="ErrorBorder"
                BorderBrush="#E5484D"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
