<Window x:Class="SimulateInputer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SimulateInputer.Controls"
        mc:Ignorable="d"
        Title="模拟输入器"
        Height="680"
        Width="880"
        MinHeight="520"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,2,16">
            <TextBlock Text="模拟输入器"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="在下方输入文本、设置热键与逐字延迟。切换到任意程序的输入框后按下热键，即可逐字模拟输入。"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 设置卡片 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="触发热键" Style="{StaticResource FieldLabelStyle}" />
                    <controls:HotkeyBox x:Name="HotkeyEditor" HotkeyChanged="OnHotkeyChanged" />
                    <TextBlock Style="{StaticResource HintStyle}"
                               Text="点击后按下组合键完成设置；Delete 清除热键。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Width="160" Margin="16,0,0,0">
                    <TextBlock Text="逐字延迟（毫秒）" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="DelayBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="{StaticResource FieldHeight}"
                             MaxLength="5"
                             PreviewTextInput="OnDelayPreviewTextInput"
                             TextChanged="OnDelayTextChanged"
                             LostFocus="OnDelayLostFocus" />
                    <TextBlock Style="{StaticResource HintStyle}" Text="0 表示尽可能快" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文本编辑卡片 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="待输入文本" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                    <TextBlock x:Name="CharCountText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="0 个字符" />
                </Grid>

                <TextBox x:Name="TextEditor"
                         Grid.Row="1"
                         Style="{StaticResource EditorTextBoxStyle}"
                         SpellCheck.IsEnabled="False"
                         TextChanged="OnTextEditorChanged" />
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="就绪"
                       TextTrimming="CharacterEllipsis" />

            <Button x:Name="StopButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    MinWidth="96"
                    Content="停止输入"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="OnStopClick" />
        </Grid>
    </Grid>
</Window>
