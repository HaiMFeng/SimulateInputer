<Window x:Class="SimulateInputer.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="ToastSuccessBrush" Color="#3ECF8E" />
        <SolidColorBrush x:Key="ToastInfoBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="ToastWarningBrush" Color="#F5A524" />
        <SolidColorBrush x:Key="ToastErrorBrush" Color="#F04438" />
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="Root"
                MinWidth="280"
                MaxWidth="400"
                Padding="16,13"
                Background="#F51F2430"
                CornerRadius="12"
                Opacity="0"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RootTransform" Y="14" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Width="22"
                        Height="22"
                        CornerRadius="11"
                        Background="{StaticResource ToastSuccessBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="IconText"
                               Text="✓"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Foreground="#F7F8FA"
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
